diff --git a/scripts/sync-challenge-definitions.py b/scripts/sync-challenge-definitions.py
new file mode 100644
index 0000000..8436a0f
--- /dev/null
+++ b/scripts/sync-challenge-definitions.py
@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""Keep standalone comparator inputs generated from their single definition owner."""
+from pathlib import Path
+import argparse
+
+ROOT = Path(__file__).resolve().parent.parent
+OWNER = ROOT / 'Stafford38/ChallengeDefinitions.lean'
+START = 'namespace Stafford\n'
+END = 'end Stafford38.TorsionCyclicity'
+
+
+def synchronized_text(path):
+    owner = OWNER.read_text()
+    definitions = owner[owner.index(START):].rstrip()
+    text = path.read_text()
+    start = text.index(START)
+    end = text.index(END, start) + len(END)
+    return text[:start] + definitions + text[end:]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--write', action='store_true', help='Regenerate standalone copies')
+    args = parser.parse_args()
+    stale = []
+    for name in ('Challenge.lean', 'FixedSourceChallenge.lean'):
+        path = ROOT / name
+        expected = synchronized_text(path)
+        if path.read_text() != expected:
+            if args.write:
+                path.write_text(expected)
+            else:
+                stale.append(name)
+    if stale:
+        raise SystemExit('Stale generated definitions: ' + ', '.join(stale) +
+                         '. Run python3 scripts/sync-challenge-definitions.py --write.')
+    print('Standalone challenge definitions match their canonical owner.')
+
+
+if __name__ == '__main__':
+    main()
