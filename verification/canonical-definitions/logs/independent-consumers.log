            (Stafford38.Geometry.LocalizedProjectiveChartTransition.homogenizeAtZero p)) ∧
      ↑r =
          ↑(C.q 0) ^ ((MvPolynomial.map (algebraMap k F)) p).totalDegree *
            (Stafford38.Geometry.ComponentProjectiveClosure.componentAffineGenericPointMap P) p ∧
        r ≠ 0
