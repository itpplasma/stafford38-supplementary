Stafford38.Geometry.ActualOptionColumnBinding.actual_normalized_column_map_eq_retained.{u} {k : Type u} [Field k]
  [CharZero k] {m : ℕ} (hm : 0 < m) (P : PrimeSpectrum (MvPolynomial (Fin m) k))
  (w : Stafford38.Geometry.GeneralDivisorialVisibleFrame.GeneralDivisorialVisibleFrameWitness hm P) :
  let C := w.column;
  let F := Stafford38.Geometry.ComponentProjectiveClosure.ComponentFractionField P;
  let echart := Stafford38.Geometry.AsymptoticChartArcAdapter.chartAffineCoordinateEquiv C.chart;
  let Q :=
    Algebra.adjoin k
      (Set.range (Stafford38.Geometry.ComponentProjectiveChartKernel.chartGenericPoint P C.chart echart));
  let B := integralClosure (↥Q.toSubring) F;
  let V := C.W.place.valuation.toSubring;
  ∀ (center : PrimeSpectrum ↥B) (e : Localization.AtPrime center.asIdeal ≃+* ↥V),
    (∀ (b : ↥B), ↑(e ((algebraMap (↥B) (Localization.AtPrime center.asIdeal)) b)) = ↑b) →
      have qB := actualNormalizedProjectiveColumnInIntegralClosure hm P w;
      e ((algebraMap (↥B) (Localization.AtPrime center.asIdeal)) (qB 0)) = C.q 0 ∧
        e ((algebraMap (↥B) (Localization.AtPrime center.asIdeal)) (qB ⟨0, hm⟩.succ)) = C.q ⟨0, hm⟩.succ
Stafford38.Geometry.ActualOptionColumnBinding.retained_frame_coordinate_orders.{u} {k : Type u} [Field k] [CharZero k]
  {m : ℕ} (hm : 0 < m) (P : PrimeSpectrum (MvPolynomial (Fin m) k))
  (w : Stafford38.Geometry.GeneralDivisorialVisibleFrame.GeneralDivisorialVisibleFrameWitness hm P) :
  let C := w.column;
  let W := C.W;
  let F := Stafford38.Geometry.ComponentProjectiveClosure.ComponentFractionField P;
  let V := W.place.valuation.toSubring;
  have D := w.differential.core.D;
  C.q 0 = Stafford38.Geometry.CompletedDVRPowerSeries.chosenUniformizer ↥V ^ D.a * D.u ∧
    C.q ⟨0, hm⟩.succ = Stafford38.Geometry.CompletedDVRPowerSeries.chosenUniformizer ↥V ^ (D.a + D.e) * D.w
