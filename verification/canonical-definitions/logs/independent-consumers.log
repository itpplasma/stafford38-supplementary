Stafford38.Geometry.SelectedResidueCoefficientLocalization.exists_selected_fraction_field_maps.{u} {k F : Type u}
  [Field k] [Field F] [Algebra k F] (Q : Subalgebra k F) (V : ValuationSubring F) [IsLocalRing ↥V.toSubring]
  [Algebra k ↥V.toSubring] (hground : ∀ (c : k), ↑((algebraMap k ↥V.toSubring) c) = (algebraMap k F) c)
  [Algebra k (IsLocalRing.ResidueField ↥V.toSubring)]
  [IsScalarTower k (↥V.toSubring) (IsLocalRing.ResidueField ↥V.toSubring)] (hQV : Q.toSubring ≤ V.toSubring)
  {t : Set (IsLocalRing.ResidueField ↥V.toSubring)} (htb : IsTranscendenceBasis k Subtype.val) (x : ↑t → ↥Q)
  (hx : ∀ (z : ↑t), (IsLocalRing.residue ↥V.toSubring) ⟨↑(x z), ⋯⟩ = ↑z) :
  have A := Algebra.adjoin k (Set.range x);
  let E := FractionRing (MvPolynomial (↑t) k);
  ∃ eA fA iA g fE,
    Function.Injective ⇑g ∧
      g.fieldRange = IntermediateField.adjoin k (Set.range fun z => ↑z) ∧
        (∀ (z : ↑t), ↑(eA (MvPolynomial.X z)) = x z) ∧
          (∀ (z : ↑t), fA (eA (MvPolynomial.X z)) = ⟨↑(x z), ⋯⟩) ∧
            (∀ (z : ↑t), g ((algebraMap (MvPolynomial (↑t) k) E) (MvPolynomial.X z)) = ↑z) ∧
              (∀ (p : MvPolynomial (↑t) k), iA (eA p) = (algebraMap (MvPolynomial (↑t) k) E) p) ∧
                (IsLocalRing.residue ↥V.toSubring).comp fE.toRingHom = g.toRingHom ∧ fE.comp iA.toRingHom = fA.toRingHom
