Stafford38.Geometry.ActualWitnessStrictOrderGap.exists_actual_witness_strict_orderGap.{u} {k : Type u} [Field k]
  [CharZero k] {m : ℕ} (hm : 0 < m) (P : PrimeSpectrum (MvPolynomial (Fin m) k))
  (w : Stafford38.Geometry.GeneralDivisorialVisibleFrame.GeneralDivisorialVisibleFrameWitness hm P) :
  let C := w.column;
  let W := C.W;
  let V := W.place.valuation.toSubring;
  ∀ (π : ↥V),
    Irreducible π →
      ∃ a r b u₀ ur u₁,
        0 < a ∧
          0 < r ∧
            b = a + r ∧
              a < b ∧
                C.q 0 = ↑u₀ * π ^ a ∧ W.place.parameter = ↑ur * π ^ r ∧ u₁ = u₀ * ur ∧ C.q ⟨0, hm⟩.succ = ↑u₁ * π ^ b
