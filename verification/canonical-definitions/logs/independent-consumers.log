  let F := Stafford38.Geometry.ComponentProjectiveClosure.ComponentFractionField P;
  have Q :=
    Algebra.adjoin k (Set.range (Stafford38.Geometry.ComponentProjectiveChartKernel.chartGenericPoint P C.chart e));
